rules_version = '2';
// Wide-open rules for a one-off classroom game (no accounts, no secrets).
// Anyone with the site can read and write rooms until the date below, after
// which the database locks itself. Change the date if you reuse it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{room=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}
